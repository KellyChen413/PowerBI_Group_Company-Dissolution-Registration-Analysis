-- =====================================================================
-- 公司解散登記清冊（2021–2025）— 計算資料行
-- 資料表：解散清冊（由「取得資料 → 資料夾 → 合併並載入」匯入 60 個 CSV）
-- 使用方式：資料表檢視 → 解散清冊 → 新增資料行 → 一次貼一段，依編號順序建立
-- =====================================================================

-- ① 設立日期：民國 0651208 → 1976/12/08（建立後資料類型設為「日期」）
設立日期 =
IF (
    ISBLANK ( '解散清冊'[核准設立日期] ),
    BLANK (),
    DATE (
        INT ( '解散清冊'[核准設立日期] / 10000 ) + 1911,
        MOD ( INT ( '解散清冊'[核准設立日期] / 100 ), 100 ),
        MOD ( '解散清冊'[核准設立日期], 100 )
    )
)

-- ② 解散日期
解散日期 =
DATE (
    INT ( '解散清冊'[核准解散日期] / 10000 ) + 1911,
    MOD ( INT ( '解散清冊'[核准解散日期] / 100 ), 100 ),
    MOD ( '解散清冊'[核准解散日期], 100 )
)

-- ③ 資料年度：檔名 202101.csv → 2021
資料年度 = LEFT ( '解散清冊'[Source.Name], 4 )

-- ④ 存活年數
存活年數 =
IF (
    ISBLANK ( '解散清冊'[設立日期] ),
    BLANK (),
    ROUND ( DATEDIFF ( '解散清冊'[設立日期], '解散清冊'[解散日期], DAY ) / 365.25, 2 )
)

-- ⑤ 存活區間
存活區間 =
VAR y = '解散清冊'[存活年數]
RETURN
    SWITCH (
        TRUE (),
        ISBLANK ( y ), "日期缺漏",
        y < 1, "1年以下",
        y < 3, "1-3年",
        y < 5, "3-5年",
        y < 10, "5-10年",
        y < 20, "10-20年",
        "20年以上"
    )

-- ⑥ 存活區間排序（存活區間 → 依資料行排序）
存活區間排序 =
SWITCH (
    '解散清冊'[存活區間],
    "1年以下", 1, "1-3年", 2, "3-5年", 3, "5-10年", 4,
    "10-20年", 5, "20年以上", 6, 7
)

-- ⑦ 縣市：地址前 3 字，「台」統一為「臺」
縣市 =
VAR 地址 = TRIM ( '解散清冊'[公司所在地] )
RETURN
    IF ( 地址 = "", "地址缺漏", SUBSTITUTE ( LEFT ( 地址, 3 ), "台", "臺" ) )

-- ⑧ 公司型態（先判斷「股份有限公司」）
公司型態 =
IF (
    CONTAINSSTRING ( '解散清冊'[公司名稱], "股份有限公司" ), "股份有限公司",
    IF ( CONTAINSSTRING ( '解散清冊'[公司名稱], "有限公司" ), "有限公司", "其他" )
)

-- ⑨ 產業關鍵字（由上往下，第一個命中者為準）
產業關鍵字 =
VAR n = '解散清冊'[公司名稱]
RETURN
    SWITCH (
        TRUE (),
        CONTAINSSTRING ( n, "生技" ), "生技",
        CONTAINSSTRING ( n, "科技" ), "科技",
        CONTAINSSTRING ( n, "資訊" ), "資訊",
        CONTAINSSTRING ( n, "餐飲" ), "餐飲",
        CONTAINSSTRING ( n, "營造" ), "營造",
        CONTAINSSTRING ( n, "工程" ), "工程",
        CONTAINSSTRING ( n, "建設" ), "建設",
        CONTAINSSTRING ( n, "投資" ), "投資",
        CONTAINSSTRING ( n, "顧問" ), "顧問",
        CONTAINSSTRING ( n, "行銷" ), "行銷",
        CONTAINSSTRING ( n, "設計" ), "設計",
        CONTAINSSTRING ( n, "貿易" ), "貿易",
        CONTAINSSTRING ( n, "國際" ), "國際",
        "其他"
    )

-- ⑩ 資本額級距
資本額級距 =
VAR c = '解散清冊'[資本額]
RETURN
    SWITCH (
        TRUE (),
        ISBLANK ( c ) || c = 0, "0或缺漏",
        c <= 100000, "10萬以下",
        c <= 500000, "10-50萬",
        c <= 1000000, "50-100萬",
        c <= 5000000, "100-500萬",
        c <= 10000000, "500-1000萬",
        c <= 100000000, "1000萬-1億",
        "1億以上"
    )

-- ⑪ 資本額級距排序
資本額級距排序 =
SWITCH (
    '解散清冊'[資本額級距],
    "0或缺漏", 1, "10萬以下", 2, "10-50萬", 3, "50-100萬", 4,
    "100-500萬", 5, "500-1000萬", 6, "1000萬-1億", 7, 8
)

-- ⑫ 地圖位置（地圖定位失敗時的備援）
地圖位置 = IF ( '解散清冊'[縣市] = "地址缺漏", BLANK (), '解散清冊'[縣市] & ", 臺灣" )

-- ⑬ 短命公司：存活未滿 1 年 = 1
短命公司 =
IF ( NOT ISBLANK ( '解散清冊'[存活年數] ) && '解散清冊'[存活年數] < 1, 1, 0 )

-- ⑭ 同址解散家數：同一地址在整份清冊出現幾次
同址解散家數 =
VAR 地址 = '解散清冊'[公司所在地]
RETURN
    IF (
        地址 = "",
        BLANK (),
        CALCULATE (
            COUNTROWS ( '解散清冊' ),
            REMOVEFILTERS ( '解散清冊' ),
            '解散清冊'[公司所在地] = 地址
        )
    )

-- ⑮ 地址群聚：同址 ≥ 3 家
地址群聚 =
IF ( '解散清冊'[同址解散家數] >= 3, "群聚地址(≥3家)", "一般地址" )

-- ⑯ 資料品質
資料品質 =
SWITCH (
    TRUE (),
    ISBLANK ( '解散清冊'[資本額] ) || '解散清冊'[資本額] = 0, "資本額為0",
    '解散清冊'[公司所在地] = "", "地址缺漏",
    ISBLANK ( '解散清冊'[設立日期] ), "設立日期缺漏",
    "正常"
)

-- ⑰ 異常標記（Page 2 篩選器）
異常標記 =
SWITCH (
    TRUE (),
    '解散清冊'[資料品質] <> "正常", "資料品質異常",
    '解散清冊'[短命公司] = 1 && '解散清冊'[地址群聚] = "群聚地址(≥3家)", "短命＋地址群聚",
    '解散清冊'[短命公司] = 1, "短命公司",
    '解散清冊'[地址群聚] = "群聚地址(≥3家)", "地址群聚",
    "正常"
)
