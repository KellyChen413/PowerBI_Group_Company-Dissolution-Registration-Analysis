-- =====================================================================
-- 公司解散登記清冊（2021–2025）— 量值
-- 使用方式：常用 → 新增量值 → 一次貼一個
-- =====================================================================

總解散家數 = COUNTROWS ( '解散清冊' )

平均資本額 =
AVERAGEX ( FILTER ( '解散清冊', '解散清冊'[資本額] > 0 ), '解散清冊'[資本額] )

中位數資本額 =
MEDIANX ( FILTER ( '解散清冊', '解散清冊'[資本額] > 0 ), '解散清冊'[資本額] )

平均存活年數 = AVERAGE ( '解散清冊'[存活年數] )

中位數存活年數 = MEDIAN ( '解散清冊'[存活年數] )

短命公司家數 = CALCULATE ( [總解散家數], '解散清冊'[短命公司] = 1 )

短命公司率 = DIVIDE ( [短命公司家數], [總解散家數] )

-- 不受篩選影響的全體基準，用來算「高於全台幾個百分點」
短命率_全台基準 = CALCULATE ( [短命公司率], REMOVEFILTERS ( '解散清冊' ) )

短命率_高於全台 = [短命公司率] - [短命率_全台基準]

地址群聚家數 =
CALCULATE ( [總解散家數], '解散清冊'[地址群聚] = "群聚地址(≥3家)" )

地址群聚占比 = DIVIDE ( [地址群聚家數], [總解散家數] )

資料異常筆數 =
CALCULATE ( [總解散家數], '解散清冊'[資料品質] <> "正常" )

-- 鑽研到 Page 2 時，標題自動顯示縣市
Page2標題 =
"短命公司剖析："
    & IF (
        ISFILTERED ( '解散清冊'[縣市] ),
        SELECTEDVALUE ( '解散清冊'[縣市], "多個縣市" ),
        "全台"
    )
